{
  "name": "@b2b/svc-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_ENV=test node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@b2b/contracts": "*",
    "@b2b/platform-kit": "*",
    "@b2b/shared": "*",
    "@prisma/client": "^6.16.3",
    "express": "^4.21.2",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@b2b/test-kit": "*",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.3",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "exports": {
    "./service": "./src/service.ts",
    "./config": "./src/config.ts"
  }
}

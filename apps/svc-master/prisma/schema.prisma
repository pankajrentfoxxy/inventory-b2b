// svc-master: products, categories, brands, units, HSN/tax, warehouses/locations/bins, payment
// terms, numbering configuration, custom fields, condition grades, warranty defaults (phase-03 3.5).
// Every table is tenant-owned and under RLS.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

model Unit {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(10)
  name      String   @db.VarChar(50)
  decimals  Int      @default(0)
  /// GST Unique Quantity Code, e.g. NOS
  uqc       String?  @db.VarChar(10)
  status    String   @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@index([tenantId])
  @@map("units")
}

model TaxRate {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String    @db.VarChar(50)
  gstRate       Decimal   @map("gst_rate") @db.Decimal(5, 2)
  cessRate      Decimal   @default(0) @map("cess_rate") @db.Decimal(5, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  status        String    @default("ACTIVE") @db.VarChar(10)

  hsnCodes HsnCode[]
  products Product[]

  @@unique([tenantId, name, effectiveFrom])
  @@index([tenantId])
  @@map("tax_rates")
}

model HsnCode {
  id               String  @id @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  code             String  @db.VarChar(8)
  /// HSN | SAC
  kind             String  @db.VarChar(3)
  description      String? @db.VarChar(300)
  defaultTaxRateId String? @map("default_tax_rate_id") @db.Uuid

  defaultTaxRate TaxRate?  @relation(fields: [defaultTaxRateId], references: [id])
  products       Product[]

  @@unique([tenantId, code])
  @@map("hsn_codes")
}

model Category {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String  @db.VarChar(100)
  /// Materialised path of ids, e.g. "root.child.grandchild" (ids without dashes).
  path     String  @db.VarChar(800)
  status   String  @default("ACTIVE") @db.VarChar(10)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([tenantId, path])
  @@map("categories")
}

model Brand {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(100)
  status   String @default("ACTIVE") @db.VarChar(10)

  products Product[]

  @@index([tenantId])
  @@map("brands")
}

model ConditionGrade {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  code      String  @db.VarChar(10)
  name      String  @db.VarChar(50)
  sortOrder Int     @map("sort_order")
  sellable  Boolean @default(true)
  status    String  @default("ACTIVE") @db.VarChar(10)

  @@unique([tenantId, code])
  @@map("condition_grades")
}

model WarrantyPolicy {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  name           String  @db.VarChar(100)
  durationMonths Int     @map("duration_months")
  /// INVOICE_DATE | DELIVERY_DATE
  startsOn       String  @map("starts_on") @db.VarChar(15)
  terms          String?
  status         String  @default("ACTIVE") @db.VarChar(10)

  products Product[]

  @@index([tenantId])
  @@map("warranty_policies")
}

model Product {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  sku               String    @db.VarChar(40)
  name              String    @db.VarChar(200)
  description       String?
  /// GOODS | SERVICE
  type              String    @db.VarChar(10)
  trackInventory    Boolean   @map("track_inventory")
  isSerialized      Boolean   @default(false) @map("is_serialized")
  requiresImei      Boolean   @default(false) @map("requires_imei")
  serialPattern     String?   @map("serial_pattern") @db.VarChar(200)
  qcRequired        Boolean   @default(true) @map("qc_required")
  categoryId        String?   @map("category_id") @db.Uuid
  brandId           String?   @map("brand_id") @db.Uuid
  unitId            String    @map("unit_id") @db.Uuid
  hsnId             String?   @map("hsn_id") @db.Uuid
  taxRateId         String?   @map("tax_rate_id") @db.Uuid
  defaultWarrantyId String?   @map("default_warranty_id") @db.Uuid
  purchasePrice     Decimal?  @map("purchase_price") @db.Decimal(18, 2)
  sellingPrice      Decimal?  @map("selling_price") @db.Decimal(18, 2)
  reorderLevel      Decimal?  @map("reorder_level") @db.Decimal(18, 3)
  attributes        Json      @default("{}")
  customFields      Json      @default("{}") @map("custom_fields")
  /// DRAFT | ACTIVE | INACTIVE | ARCHIVED
  status            String    @db.VarChar(10)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int       @default(0)

  category        Category?       @relation(fields: [categoryId], references: [id])
  brand           Brand?          @relation(fields: [brandId], references: [id])
  unit            Unit            @relation(fields: [unitId], references: [id])
  hsn             HsnCode?        @relation(fields: [hsnId], references: [id])
  taxRate         TaxRate?        @relation(fields: [taxRateId], references: [id])
  defaultWarranty WarrantyPolicy? @relation(fields: [defaultWarrantyId], references: [id])

  // UNIQUE (tenant_id, lower(sku)) and the CHECK constraints live in the migration.
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("products")
}

model Warehouse {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(100)
  address   Json
  /// GST place of supply
  stateCode String   @map("state_code") @db.Char(2)
  gstin     String?  @db.Char(15)
  isDefault Boolean  @default(false) @map("is_default")
  /// ACTIVE | INACTIVE
  status    String   @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(0)

  locations Location[]

  // UNIQUE (tenant_id, lower(code)) and one default per tenant live in the migration.
  @@index([tenantId, status])
  @@map("warehouses")
}

model Location {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  code        String  @db.VarChar(20)
  name        String? @db.VarChar(100)
  /// RECEIVING | QC | STORAGE | PACKING | DISPATCH | QUARANTINE
  purpose     String? @db.VarChar(15)
  status      String  @default("ACTIVE") @db.VarChar(10)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bins      Bin[]

  @@index([tenantId, warehouseId])
  @@map("locations")
}

model Bin {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  code       String   @db.VarChar(20)
  capacity   Decimal? @db.Decimal(18, 3)
  status     String   @default("ACTIVE") @db.VarChar(10)
  version    Int      @default(0)

  location Location @relation(fields: [locationId], references: [id])

  @@index([tenantId, locationId])
  @@map("bins")
}

model PaymentTerm {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String  @db.VarChar(60)
  days      Int
  isDefault Boolean @default(false) @map("is_default")
  status    String  @default("ACTIVE") @db.VarChar(10)

  @@index([tenantId])
  @@map("payment_terms")
}

model NumberingConfig {
  tenantId       String  @map("tenant_id") @db.Uuid
  docType        String  @map("doc_type") @db.VarChar(10)
  /// e.g. "PO/{FY}/" -> PO/26-27/0001
  prefixTemplate String  @map("prefix_template") @db.VarChar(40)
  padding        Int     @default(4)
  resetEachFy    Boolean @default(true) @map("reset_each_fy")

  @@id([tenantId, docType])
  @@map("numbering_configs")
}

model CustomFieldDef {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  entity   String  @db.VarChar(30)
  key      String  @db.VarChar(40)
  label    String  @db.VarChar(100)
  /// TEXT | NUMBER | DATE | BOOLEAN | SELECT
  dataType String  @map("data_type") @db.VarChar(10)
  options  Json?
  required Boolean @default(false)
  status   String  @default("ACTIVE") @db.VarChar(10)

  @@unique([tenantId, entity, key])
  @@map("custom_field_defs")
}

/// Delete guards: one row per (entity, referencing service), fed by events from other services.
model EntityReference {
  tenantId     String   @map("tenant_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(30)
  entityId     String   @map("entity_id") @db.Uuid
  referencedBy String   @map("referenced_by") @db.VarChar(30)
  firstSeenAt  DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)

  @@id([tenantId, entityType, entityId, referencedBy])
  @@map("entity_references")
}

model IdempotencyKey {
  tenantId     String   @map("tenant_id") @db.Uuid
  scope        String
  key          String   @db.Uuid
  requestHash  String   @map("request_hash") @db.Char(64)
  status       String   @default("IN_PROGRESS") @db.VarChar(20)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  eventVersion  Int       @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

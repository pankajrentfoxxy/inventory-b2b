# --- svc-party ---
PORT=4107
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://party_role:b2b_dev@localhost:5435/party_db?schema=public
MIGRATE_DATABASE_URL=postgresql://party_migrator:b2b_dev@localhost:5435/party_db?schema=public
AMQP_URL=amqp://b2b:b2b_dev@localhost:5672
AMQP_EXCHANGE=domain.events
AUTH_JWKS_URL=http://localhost:4101/.well-known/jwks.json
AUTH_ISSUER=svc-auth
AUTH_AUDIENCE=b2b-inventory
AUTH_URL=http://localhost:4101
SERVICE_CLIENT_ID=svc-party
SERVICE_CLIENT_SECRET=dev-secret-party
# Encrypts bank account numbers at rest (32 bytes base64). Use the legacy API's key to keep migrated
# accounts readable, or set LEGACY_APP_ENCRYPTION_KEY for the migration script to re-encrypt.
APP_ENCRYPTION_KEY=

# --- Gateway ---
PORT=4010
NODE_ENV=development
LOG_LEVEL=info

# Upstreams (routing table: src/routes.ts)
LEGACY_API_URL=http://localhost:4000
AUTH_URL=http://localhost:4101
TENANT_URL=http://localhost:4102
AUDIT_URL=http://localhost:4103
# Later phases
IAM_URL=
MASTER_URL=
PARTY_URL=
INVENTORY_URL=
PROCUREMENT_URL=
QC_URL=

# Token verification: RS256 via svc-auth JWKS (default: AUTH_URL/.well-known/jwks.json)
AUTH_JWKS_URL=http://localhost:4101/.well-known/jwks.json
AUTH_ISSUER=svc-auth
AUTH_AUDIENCE=b2b-inventory
# Legacy HS256 adapter (falls back to apps/api/.env JWT_SECRET). Remove at the Phase 1 cut-over.
LEGACY_JWT_SECRET=

# Service credentials for the tenant-status fallback lookup (must match svc-auth SERVICE_CLIENTS)
SERVICE_CLIENT_ID=gateway
SERVICE_CLIENT_SECRET=dev-secret-gateway

# Caches fed by tenant / iam events. Empty REDIS_URL = in-memory (single instance only).
REDIS_URL=redis://localhost:6380
AMQP_URL=amqp://b2b:b2b_dev@localhost:5672
AMQP_EXCHANGE=domain.events
TENANT_STATUS_TTL_SEC=300

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_IP=600
RATE_LIMIT_PER_PRINCIPAL=300
BODY_LIMIT_BYTES=10485760
PROXY_TIMEOUT_MS=30000

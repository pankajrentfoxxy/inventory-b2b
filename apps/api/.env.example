# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 14+) ---
# Local dev reuses the team's shared container `laptop-erp-postgres` (port 5433).
# Or run `npm run db:up` at the repo root for a dedicated one on port 5434:
#   postgresql://b2b:b2b_dev@localhost:5434/b2b_inventory?schema=public
DATABASE_URL=postgresql://postgres:password123@localhost:5433/b2b_inventory?schema=public

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Field-level encryption (vendor bank account numbers) ---
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- GST portal lookup (vendor prefill) ---
# none          -> lookup disabled, PAN/state still derived from the GSTIN locally
# zoho-session  -> Zoho Inventory GSTIN search using a logged-in browser session.
#                  Copy the Cookie header and CSRF_TOKEN from an authenticated request in
#                  DevTools. Sessions expire; refresh them when the UI reports it.
GST_PROVIDER=none
ZOHO_GST_BASE_URL=https://inventory.zoho.in
ZOHO_GST_ORGANIZATION_ID=
ZOHO_GST_COOKIE=
ZOHO_GST_CSRF_TOKEN=
ZOHO_GST_ROLE_ID=

# --- File storage for vendor documents ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

// svc-tenant: platform tenants (the business's "vendors"), lifecycle, settings, applications
// (phase-01 1.5). Platform-owned tables: no tenant RLS.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

model Tenant {
  id                String    @id @db.Uuid
  /// Short immutable slug.
  code              String    @unique @db.VarChar(40)
  legalName         String    @map("legal_name") @db.VarChar(200)
  displayName       String    @map("display_name") @db.VarChar(150)
  pan               String?   @db.Char(10)
  gstin             String?   @db.Char(15)
  registeredAddress Json      @map("registered_address")
  /// GST state code; drives IGST vs CGST/SGST later.
  stateCode         String?   @map("state_code") @db.Char(2)
  ownerName         String    @map("owner_name") @db.VarChar(150)
  ownerEmail        String    @map("owner_email") @db.VarChar(254)
  ownerPhone        String?   @map("owner_phone") @db.VarChar(30)
  /// PENDING | APPROVED | ACTIVE | SUSPENDED | DEACTIVATED | REJECTED
  status            String    @db.VarChar(15)
  statusReason      String?   @map("status_reason") @db.VarChar(500)
  /// ADMIN_CREATED | APPLICATION | LEGACY_MIGRATION
  source            String    @db.VarChar(20)
  createdBy         String?   @map("created_by") @db.Uuid
  approvedBy        String?   @map("approved_by") @db.Uuid
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  activatedAt       DateTime? @map("activated_at") @db.Timestamptz(6)
  suspendedAt       DateTime? @map("suspended_at") @db.Timestamptz(6)
  deactivatedAt     DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int       @default(0)

  history      TenantStatusHistory[]
  settings     TenantSettings?
  applications VendorApplication[]

  // UNIQUE (gstin) WHERE gstin IS NOT NULL AND status <> 'REJECTED' lives in the migration.
  @@index([status, createdAt])
  @@index([ownerEmail])
  @@map("tenants")
}

model TenantStatusHistory {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(15)
  toStatus   String   @map("to_status") @db.VarChar(15)
  reason     String?  @db.VarChar(500)
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name") @db.VarChar(150)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, occurredAt])
  @@map("tenant_status_history")
}

model TenantSettings {
  tenantId     String @id @map("tenant_id") @db.Uuid
  timezone     String @default("Asia/Kolkata") @db.VarChar(60)
  fyStartMonth Int    @default(4) @map("fy_start_month")
  baseCurrency String @default("INR") @map("base_currency") @db.Char(3)
  features     Json   @default("{}")
  limits       Json   @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model VendorApplication {
  id           String   @id @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  payload      Json
  submittedIp  String?  @map("submitted_ip") @db.VarChar(45)
  captchaScore Decimal? @map("captcha_score") @db.Decimal(4, 3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("vendor_applications")
}

/* ---- standard platform tables ---- */

model IdempotencyKey {
  tenantId     String   @map("tenant_id") @db.Uuid
  scope        String
  key          String   @db.Uuid
  requestHash  String   @map("request_hash") @db.Char(64)
  status       String   @default("IN_PROGRESS") @db.VarChar(20)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  eventVersion  Int       @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

# --- svc-inventory ---
PORT=4108
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://inventory_role:b2b_dev@localhost:5435/inventory_db?schema=public
MIGRATE_DATABASE_URL=postgresql://inventory_migrator:b2b_dev@localhost:5435/inventory_db?schema=public
AMQP_URL=amqp://b2b:b2b_dev@localhost:5672
AMQP_EXCHANGE=domain.events
AUTH_JWKS_URL=http://localhost:4101/.well-known/jwks.json
AUTH_ISSUER=svc-auth
AUTH_AUDIENCE=b2b-inventory
AUTH_URL=http://localhost:4101
SERVICE_CLIENT_ID=svc-inventory
SERVICE_CLIENT_SECRET=dev-secret-inventory
# Document number formats (ADJ/...) come from svc-master; empty = default format "ADJ/{FY}/0001".
MASTER_URL=http://localhost:4106

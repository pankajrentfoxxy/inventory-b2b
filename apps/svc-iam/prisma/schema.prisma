// svc-iam: memberships, invitations, roles, permissions (phase-02 2.5). Tenant-scoped tables are
// under RLS; platform staff rows have tenant_id NULL and are reachable only in platform context.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

model Permission {
  code         String    @id @db.VarChar(80)
  module       String    @db.VarChar(40)
  /// TENANT | PLATFORM
  scope        String    @db.VarChar(10)
  description  String    @db.VarChar(200)
  isSensitive  Boolean   @default(false) @map("is_sensitive")
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @db.Uuid
  /// NULL = platform role
  tenantId    String?  @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(60)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  isSystem    Boolean  @default(false) @map("is_system")
  rank        Int
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(0)

  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  // UNIQUE (tenant_id, key) + partial unique on key WHERE tenant_id IS NULL live in the migration.
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId         String  @map("role_id") @db.Uuid
  permissionCode String  @map("permission_code") @db.VarChar(80)
  tenantId       String? @map("tenant_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@index([tenantId])
  @@map("role_permissions")
}

model Membership {
  id                String    @id @db.Uuid
  /// NULL = platform staff
  tenantId          String?   @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// Snapshot for lists (identity lives in svc-auth).
  email             String    @db.VarChar(254)
  fullName          String    @map("full_name") @db.VarChar(150)
  /// INVITED | ACTIVE | SUSPENDED | REMOVED
  status            String    @db.VarChar(10)
  permissionVersion Int       @default(1) @map("permission_version")
  allWarehouses     Boolean   @default(true) @map("all_warehouses")
  joinedAt          DateTime? @map("joined_at") @db.Timestamptz(6)
  suspendedAt       DateTime? @map("suspended_at") @db.Timestamptz(6)
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(6)
  statusReason      String?   @map("status_reason") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int       @default(0)

  roles           MembershipRole[]
  warehouseScopes MembershipWarehouseScope[]

  // UNIQUE (tenant_id, user_id) + partial unique on user_id WHERE tenant_id IS NULL live in the migration.
  @@index([tenantId, status])
  @@index([userId])
  @@map("memberships")
}

model MembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  assignedBy   String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model MembershipWarehouseScope {
  membershipId String @map("membership_id") @db.Uuid
  warehouseId  String @map("warehouse_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, warehouseId])
  @@map("membership_warehouse_scopes")
}

model Invitation {
  id           String    @id @db.Uuid
  /// NULL = platform staff invitation
  tenantId     String?   @map("tenant_id") @db.Uuid
  email        String    @db.VarChar(254)
  fullName     String?   @map("full_name") @db.VarChar(150)
  roleIds      String[]  @map("role_ids") @db.Uuid
  warehouseIds String[]  @map("warehouse_ids") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  /// PENDING | ACCEPTED | REVOKED | EXPIRED
  status       String    @db.VarChar(10)
  invitedBy    String?   @map("invited_by") @db.Uuid
  invitedByName String?  @map("invited_by_name") @db.VarChar(150)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // UNIQUE (tenant_id, email) WHERE status = 'PENDING' lives in the migration.
  @@index([tenantId, status])
  @@map("invitations")
}

model IdempotencyKey {
  tenantId     String   @map("tenant_id") @db.Uuid
  scope        String
  key          String   @db.Uuid
  requestHash  String   @map("request_hash") @db.Char(64)
  status       String   @default("IN_PROGRESS") @db.VarChar(20)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  eventVersion  Int       @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

# --- svc-iam ---
PORT=4105
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://iam_role:b2b_dev@localhost:5435/iam_db?schema=public
MIGRATE_DATABASE_URL=postgresql://iam_migrator:b2b_dev@localhost:5435/iam_db?schema=public
AMQP_URL=amqp://b2b:b2b_dev@localhost:5672
AMQP_EXCHANGE=domain.events
AUTH_JWKS_URL=http://localhost:4101/.well-known/jwks.json
AUTH_ISSUER=svc-auth
AUTH_AUDIENCE=b2b-inventory
# svc-iam creates identities through svc-auth when an invitation is accepted
AUTH_URL=http://localhost:4101
SERVICE_CLIENT_ID=svc-iam
SERVICE_CLIENT_SECRET=dev-secret-iam
INVITATION_TTL_HOURS=72

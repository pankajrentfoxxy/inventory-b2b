// svc-auth: identities, credentials, sessions, refresh tokens, MFA, signing keys (phase-01 1.5).
// Identity is platform-owned (no tenant RLS); tenant-scoped rows here are bootstrap tables that
// move to svc-iam in Phase 2.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

model User {
  id               String    @id @db.Uuid
  /// Stored lower-cased; unique.
  email            String    @unique @db.VarChar(254)
  phone            String?   @db.VarChar(30)
  fullName         String    @map("full_name") @db.VarChar(150)
  /// PLATFORM | TENANT
  userType         String    @map("user_type") @db.VarChar(10)
  /// Null until an invite is accepted.
  passwordHash     String?   @map("password_hash")
  /// argon2id | bcrypt (legacy, rehashed on next login)
  passwordAlgo     String    @default("argon2id") @map("password_algo") @db.VarChar(20)
  mfaSecretEnc     String?   @map("mfa_secret_enc")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  /// INVITED | ACTIVE | LOCKED | DISABLED
  status           String    @default("ACTIVE") @db.VarChar(10)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int       @default(0)

  sessions            Session[]
  resetTokens         PasswordResetToken[]
  inviteTokens        InviteToken[]
  platformRoles       PlatformRoleAssignment[]
  bootstrapMembership TenantMembershipBootstrap[]

  @@map("users")
}

model Session {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// null for platform sessions
  tenantId     String?   @map("tenant_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid
  /// tenant | platform
  tokenType    String    @map("token_type") @db.VarChar(10)
  ip           String?   @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(400)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?   @map("revoke_reason") @db.VarChar(100)

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([tenantId])
  @@index([membershipId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// sha256 of the raw token; the raw token is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Rotation family: presenting an already-used token revokes the family (reuse detection).
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@index([familyId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Owner invites (Phase 1). Member invitations are owned by svc-iam from Phase 2.
model InviteToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  /// OWNER
  kind      String    @db.VarChar(20)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("invite_tokens")
}

/// Temporary: moves to iam_db in Phase 2.
model PlatformRoleAssignment {
  userId String @map("user_id") @db.Uuid
  /// PLATFORM_SUPER_ADMIN | PLATFORM_REVIEWER | PLATFORM_SUPPORT
  role   String @db.VarChar(40)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
  @@map("platform_role_assignments")
}

/// Temporary: migrated to iam_db in Phase 2.
model TenantMembershipBootstrap {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("OWNER") @db.VarChar(40)
  status    String   @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships_bootstrap")
}

/// Local replica of tenant lifecycle status, fed by tenant.tenant.* events (README 5.9: cross-service
/// state that may lag by seconds). Login and refresh deny when not ACTIVE.
model TenantStatusReplica {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  status    String   @db.VarChar(15)
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_status_replica")
}

/// RS256 signing keys; two may be active during rotation (ADR-0003). Private key encrypted at rest.
model SigningKey {
  kid           String    @id @db.VarChar(40)
  privateKeyEnc String    @map("private_key_enc")
  publicKeyPem  String    @map("public_key_pem")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(6)

  @@map("signing_keys")
}

/* ---- standard platform tables (owned by platform-kit; raw SQL) ---- */

model IdempotencyKey {
  tenantId     String   @map("tenant_id") @db.Uuid
  scope        String
  key          String   @db.Uuid
  requestHash  String   @map("request_hash") @db.Char(64)
  status       String   @default("IN_PROGRESS") @db.VarChar(20)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  eventVersion  Int       @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  envelope      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

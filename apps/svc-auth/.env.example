# --- svc-auth ---
PORT=4101
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# infra/docker-compose.yml database (database per service, ADR-0001)
DATABASE_URL=postgresql://auth_role:b2b_dev@localhost:5435/auth_db?schema=public
MIGRATE_DATABASE_URL=postgresql://auth_migrator:b2b_dev@localhost:5435/auth_db?schema=public

# Broker (empty = log events). Redis is not used by svc-auth.
AMQP_URL=amqp://b2b:b2b_dev@localhost:5672
AMQP_EXCHANGE=domain.events

# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts signing private keys and MFA secrets at rest.
APP_ENCRYPTION_KEY=

# Tokens (ADR-0003)
AUTH_ISSUER=svc-auth
AUTH_AUDIENCE=b2b-inventory
ACCESS_TOKEN_TTL_SEC=600
REFRESH_TOKEN_TTL_DAYS=14
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MIN=5
PLATFORM_MFA_REQUIRED=on
# DEVELOPMENT ONLY: fixed 6-digit code accepted as the platform two-factor code (every use is audited).
# svc-auth refuses to start with it when NODE_ENV=production. Leave empty to require a real authenticator.
MFA_DEV_BYPASS_CODE=
COOKIE_SECURE=off

# Client credentials for service tokens: "<serviceName>:<secret>,<serviceName>:<secret>"
SERVICE_CLIENTS=svc-tenant:dev-secret-tenant,svc-iam:dev-secret-iam,svc-notification:dev-secret-notification,gateway:dev-secret-gateway,legacy-api:dev-secret-legacy,svc-master:dev-secret-master,svc-party:dev-secret-party,svc-inventory:dev-secret-inventory,svc-procurement:dev-secret-procurement,svc-qc:dev-secret-qc,svc-audit:dev-secret-audit

# Peers
TENANT_URL=http://localhost:4102
# Phase 2: when set, effective permissions come from svc-iam instead of the bootstrap table.
IAM_URL=
